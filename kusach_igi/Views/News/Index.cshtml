@model NewsListViewModel

@{
    ViewData["Title"] = "Новости";
}

<section class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
    <div>
        <h1 class="mb-2">Лента новостей</h1>
        <p class="text-secondary mb-0">Подробный список публикаций с фильтрацией по категории и поиском по ключевым словам.</p>
    </div>

    <form method="get" class="d-flex gap-2">
        <input type="text" name="query" value="@Model.SearchQuery" class="form-control" placeholder="Поиск по заголовку или тегу" />
        <button type="submit" class="btn btn-primary">Найти</button>
    </form>
</section>

<section class="mb-4">
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="News" asp-action="Index" class="btn @(string.IsNullOrWhiteSpace(Model.SelectedCategory) ? "btn-primary" : "btn-outline-primary")">Все</a>
        @foreach (var category in Model.Categories)
        {
            <a asp-controller="News"
               asp-action="Index"
               asp-route-category="@category.Name"
               asp-route-query="@Model.SearchQuery"
               class="btn @(Model.SelectedCategory == category.Name ? "btn-primary" : "btn-outline-primary")">
                @category.Name
            </a>
        }
    </div>
</section>

<section class="row g-4">
    @if (Model.Articles.Count == 0)
    {
        <div class="col-12">
            <div class="content-card">
                <h2 class="h4">Ничего не найдено</h2>
                <p class="mb-0">Попробуйте изменить запрос или выбрать другой раздел.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var article in Model.Articles)
        {
            <div class="col-12">
                <article class="content-card">
                    <div class="row g-3 align-items-center">
                        <div class="col-lg-9">
                            <div class="small text-primary fw-semibold mb-2">@article.Category</div>
                            <h2 class="h4 mb-2">@article.Title</h2>
                            <p class="text-secondary mb-3">@article.Summary</p>
                            <div class="d-flex flex-wrap gap-3 small text-muted">
                                <span>@article.Author</span>
                                <span>@article.PublishedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                <span>@article.ReadMinutes мин чтения</span>
                                <span>@article.Views просмотров</span>
                            </div>
                        </div>
                        <div class="col-lg-3 text-lg-end">
                            <a href="/news/@article.Slug" class="btn btn-primary">Открыть материал</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    }
</section>
