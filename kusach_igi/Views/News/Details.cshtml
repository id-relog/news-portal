@model NewsDetailsViewModel

@{
    ViewData["Title"] = Model.Article.Title;
}

<article class="content-card mb-4">
    <div class="small text-primary fw-semibold mb-2">@Model.Article.Category</div>
    <h1 class="mb-3">@Model.Article.Title</h1>
    <p class="lead text-secondary">@Model.Article.Summary</p>

    <div class="d-flex flex-wrap gap-3 small text-muted mb-4">
        <span>Автор: @Model.Article.Author</span>
        <span>@Model.Article.PublishedAt.ToString("dd.MM.yyyy HH:mm")</span>
        <span>@Model.Article.ReadMinutes мин чтения</span>
        <span>@Model.Article.Views просмотров</span>
        <span>@Model.Article.CommentsCount комментариев</span>
    </div>

    <div class="article-body mb-4">
        <p>@Model.Article.Content</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @foreach (var tag in Model.Article.Tags)
        {
            <span class="badge rounded-pill text-bg-light border">@tag</span>
        }
    </div>
</article>

<section class="mb-4">
    <div class="content-card">
        <h2 class="h4 mb-3">Краткая аналитика публикации</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="metric-box">
                    <strong>@Model.Article.Views</strong>
                    <span>просмотров</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="metric-box">
                    <strong>@Model.Article.CommentsCount</strong>
                    <span>комментариев</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="metric-box">
                    <strong>@Model.Article.Tags.Count</strong>
                    <span>тегов</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Похожие материалы</h2>
        <a asp-controller="News" asp-action="Index" class="text-decoration-none">К списку новостей</a>
    </div>
    <div class="row g-4">
        @foreach (var article in Model.RelatedArticles)
        {
            <div class="col-md-4">
                <div class="content-card h-100">
                    <div class="small text-primary fw-semibold mb-2">@article.Category</div>
                    <h3 class="h5">@article.Title</h3>
                    <p class="text-secondary">@article.Summary</p>
                    <a href="/news/@article.Slug" class="text-decoration-none">Читать</a>
                </div>
            </div>
        }
    </div>
</section>
