@{
    ViewData["Title"] = "Новостной портал";
}

@model WebAppUI.Models.Home.HomeIndexViewModel


<section class="hero-section">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-5">🌟 Добро пожаловать в News Portal</h1>
            <p class="lead mb-4">Актуальные новости, профессиональный и аналитика в одном приложении.</p>
            <div class="d-flex gap-3">
                <a class="btn btn-light btn-lg" asp-controller="News" asp-action="Index">
                    <strong>📰 Читать новости</strong>
                </a>
                @if (!User.Identity?.IsAuthenticated ?? false)
                {
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">
                        <strong>📝 Присоединиться</strong>
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-4 text-end d-none d-lg-block">
            <div style="font-size: 6rem; opacity: 0.3;">📰</div>
        </div>
    </div>
</section>

@if (Model.TopArticles.Count > 0)
{
    <section class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-4">
            <h2 class="mb-0">🔥 Топ по просмотрам</h2>
            <span class="badge bg-primary">популярное</span>
        </div>
        <div class="list-group">
            @foreach (var a in Model.TopArticles.Take(5))
            {
                <a class="list-group-item list-group-item-action" asp-controller="News" asp-action="Details" asp-route-slug="@a.Slug">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h5 class="card-title mb-1">@a.Title</h5>
                            <small class="text-muted">@((a.PublishedAtUtc ?? a.CreatedAtUtc).ToLocalTime().ToString("dd MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("ru-RU")))</small>
                        </div>
                        <span class="badge bg-success ms-2">👁 @a.ViewsCount</span>
                    </div>
                </a>
            }
        </div>
    </section>
}


@if (Model.LatestArticles.Count > 0)
{
    <section class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-4">
            <h2 class="mb-0">⭐ Свежие публикации</h2>
            <span class="badge bg-info">новое</span>
        </div>
        <div class="row g-4">
            @foreach (var a in Model.LatestArticles.Take(6))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(a.ImageUrl))
                        {
                            <div style="position: relative; overflow: hidden; height: 200px;">
                                <img src="@a.ImageUrl" class="card-img-top news-home-image" alt="@a.Title" />
                                <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.2) 100%);"></div>
                            </div>
                        }
                        else
                        {
                            <div style="height: 200px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 3rem;">
                                📰
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@a.Title</h5>
                            <p class="card-text text-muted flex-grow-1">@a.Summary</p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="text-muted">
                                    @((a.PublishedAtUtc ?? a.CreatedAtUtc).ToLocalTime().ToString("dd.MM.yyyy", System.Globalization.CultureInfo.GetCultureInfo("ru-RU")))
                                </small>
                                <a asp-controller="News" asp-action="Details" asp-route-slug="@a.Slug" class="btn btn-sm btn-primary stretched-link">
                                    Читать →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (Model.LatestArticles.Count == 0)
{
    <div class="alert alert-info text-center py-5">
        <h4>📭 Нет публикаций</h4>
        <p>Пока нет опубликованных статей. Проверьте позже!</p>
    </div>
}
