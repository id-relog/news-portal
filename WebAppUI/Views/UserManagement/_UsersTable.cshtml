@model List<WebAppUI.Models.UserViewModel>
@using WebAppUI.Helpers

@if (!Model.Any())
{
        <p class="text-muted">Пользователи не найдены.</p>
}
else
{
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Роли</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                        <tr>
                            <td>@Html.HighlightMatch(user.Email, Context.Request.Query["term"])</td>
                            <td>
                        @foreach (var role in user.Roles)
                        {
                            @Html.RoleBadge(role)
                        }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Редактировать</a>

                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Удалить пользователя @user.Email?')">
                                        Удалить
                                    </button>
                                </form>
                            </td>
                        </tr>
            }
            </tbody>
        </table>
}