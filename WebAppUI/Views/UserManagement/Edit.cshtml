@model WebAppUI.Models.EditUserViewModel

@{
    ViewData["Title"] = "Редактирование ролей";
}

<h2 class="mt-4">Редактирование ролей пользователя: @Model.Email</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Роли</label>
                @foreach (var role in Model.AvailableRoles)
                {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                        @(Model.SelectedRoles.Contains(role) ? "checked" : "") />
                            <label class="form-check-label">@role</label>
                        </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Отмена</a>
        </form>
    </div>
</div>