@model WebAppUI.Models.News.CategoryEditorViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Редактирование категории" : "Новая категория";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<form method="post" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Slug" class="form-label"></label>
            <input asp-for="Slug" class="form-control" />
            <div class="form-text">Можно оставить пустым, будет сгенерирован автоматически.</div>
            <span asp-validation-for="Slug" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-action="Categories" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
