<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - News Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebAppUI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-newspaper"></i> News Portal
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">Новости</a>
                        </li>
                        

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Administrator") || User.IsInRole("Manager") || User.IsInRole("Correspondent") || User.IsInRole("Moderator") || User.IsInRole("Analyst"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="editorMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        📝 Редакция
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="editorMenu">
                                        @if (User.IsInRole("Administrator") || User.IsInRole("Manager") || User.IsInRole("Correspondent") || User.IsInRole("Moderator"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="News" asp-action="Manage">📰 Управление новостями</a></li>
                                        }
                                        @if (User.IsInRole("Analyst") || User.IsInRole("Administrator"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Analytics" asp-action="Index">📊 Аналитика публикаций</a></li>
                                        }
                                    </ul>
                                </li>

                            }

                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="UserManagement" asp-action="Index">👥 Пользователи</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="News" asp-action="Categories">🏷️ Категории</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2 ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-muted">👋 @User.Identity?.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">🚪 Выйти</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">🔓 Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">📝 Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top mt-5">
        <div class="container">
            <div class="row py-4">
                <div class="col-md-4">
                    <h5>News Portal</h5>
                    <p class="text-muted">Актуальные новости и редакционный workflow в одном приложении.</p>
                </div>
                <div class="col-md-4">
                    <h5>Ссылки</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="Index">Главная</a></li>
                        <li><a asp-controller="News" asp-action="Index">Новости</a></li>
                        
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Информация</h5>
                    <p class="text-muted">&copy; 2026 News Portal. Все права защищены.</p>
                </div>
            </div>
            <div class="border-top pt-3 text-center text-muted">
                <small>Разработано с ❤️ для управления новостями</small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
